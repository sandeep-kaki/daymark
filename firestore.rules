rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owns(uid) {
      return request.auth != null && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    match /users/{uid}/daymark/workspace {
      allow get: if owns(uid);
      allow create, update: if owns(uid)
        && request.resource.data.keys().hasOnly(['generation','count','version'])
        && request.resource.data.version == 1
        && request.resource.data.generation is string
        && request.resource.data.generation.size() == 36
        && request.resource.data.count is int
        && request.resource.data.count >= 1 && request.resource.data.count <= 80;
      match /parts/{part} {
        allow get, delete: if owns(uid);
        allow create, update: if owns(uid) && part.matches('[0-9]{1,2}')
          && request.resource.data.keys().hasOnly(['text','generation'])
          && request.resource.data.text is string && request.resource.data.text.size() <= 480004
          && request.resource.data.generation is string && request.resource.data.generation.size() == 36;
      }
    }
  }
}
